-- Efecto de brillo para los créditos (opcional)
local function crearEfectoBrillo()
    local brillo = Instance.new("Frame")
    brillo.Size = UDim2.new(1, 0, 1, 0)
    brillo.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    brillo.BackgroundTransparency = 0.8
    brillo.Parent = creditosLabel
    
    local brilloCorner = Instance.new("UICorner")
    brilloCorner.CornerRadius = UDim.new(0, 5)
    brilloCorner.Parent = brillo
    
    -- Animación del brillo
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    local tween = TweenService:Create(brillo, tweenInfo, {BackgroundTransparency = 0.4})
    tween:Play()
end
crearEfectoBrillo()

-- Hacer el botón movible
local dragging = false
local dragStart = nil
local startPos = nil

-- Función para actualizar la posición del botón
local function updatePosition(input)
    local delta = input.Position - dragStart
    local newPosition = UDim2.new(
        startPos.X.Scale, 
        startPos.X.Offset + delta.X,
        startPos.Y.Scale, 
        startPos.Y.Offset + delta.Y
    )
    boton.Position = newPosition
end

-- Conectar eventos de arrastre
boton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = boton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

boton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then
            updatePosition(input)
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
        updatePosition(input)
    end
end)

-- Función que ejecuta el código de las armas
local function ejecutarCodigoArmas()
    -- Tu código original aquí
    local skinsFolder = player:FindFirstChild("SkinsFolder")
    if not skinsFolder then 
        warn("No se encontró SkinsFolder")
        
        -- Mensaje de error en el label de créditos
        creditosLabel.Text = "ERROR: No SkinsFolder"
        creditosLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        task.wait(2)
        creditosLabel.Text = "BY EL PEPE"
        creditosLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        return 
    end

    local function giveItems(folder)
        for _, item in pairs(folder:GetChildren()) do
            if not skinsFolder:FindFirstChild(item.Name) then
                local stringValue = Instance.new("StringValue")
                stringValue.Name = item.Name
                stringValue.Value = item.Name

                local count = Instance.new("IntValue")
                count.Name = "Count"
                count.Value = 86
                count.Parent = stringValue

                stringValue.Parent = skinsFolder
            end
        end
    end

    local skins = ReplicatedStorage:FindFirstChild("Skins")
    local exclusive = ReplicatedStorage:FindFirstChild("ExclusiveSkins")

    if skins then
        if skins:FindFirstChild("Guns") then giveItems(skins.Guns) end
        if skins:FindFirstChild("Knives") then giveItems(skins.Knives) end
    end

    if exclusive then
        if exclusive:FindFirstChild("Guns") then giveItems(exclusive.Guns) end
        if exclusive:FindFirstChild("Knives") then giveItems(exclusive.Knives) end
    end

    -- Notificación visual de éxito
    boton.Text = "¡ARMAS OBTENIDAS!"
    boton.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    
    -- Cambiar créditos temporalmente
    creditosLabel.Text = "¡GRACIAS POR USAR!"
    creditosLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    
    -- Efecto de animación
    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tweenBoton = TweenService:Create(boton, tweenInfo, {TextColor3 = Color3.new(1, 1, 1)})
    tweenBoton:Play()
    
    local tweenCreditos = TweenService:Create(creditosLabel, tweenInfo, {TextColor3 = Color3.new(1, 1, 1)})
    tweenCreditos:Play()
    
    -- Volver al texto original después de 2 segundos
    task.wait(2)
    boton.Text = "TODAS LAS ARMAS"
    boton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    creditosLabel.Text = "BY EL PEPE"
    creditosLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- Conectar el clic del botón
boton.MouseButton1Click:Connect(ejecutarCodigoArmas)
boton.TouchTap:Connect(ejecutarCodigoArmas) -- Para dispositivos táctiles

